# Скопіюйте у .env і заповніть. Файл .env НЕ комітьте.
ANTHROPIC_API_KEY=
# Домен для HTTPS. Без власного домену: IP з дефісами + .sslip.io, напр. 203-0-113-5.sslip.io
DOMAIN=
# Вхід у диспетчерську (/dispatch)
DISPATCH_USER=dispatcher
DISPATCH_PASSWORD=
# Ваш email для OpenStreetMap (вимога їхніх правил)
CONTACT_EMAIL=
# Скільки аналізів фото на годину з однієї IP-адреси
ANALYZE_PER_HOUR=20
